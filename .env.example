# Copy to .env (gitignored) and fill in. Where to get each value: docs/env-setup.md
# Used by `npm run dev` in backend/.
# For a deployed Worker, set the same names with `npx wrangler secret put <NAME>`.

# Required for every formula. Needs the Decisions API (AI.CHECK) and Agents API beta (AI.WATCH).
OPENAI_API_KEY=

# Required only for Track bills (Gmail).
COMPOSIO_API_KEY=
# ID of a Composio Gmail auth config that requests only gmail.readonly (starts with ac_).
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
