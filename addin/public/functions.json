{
  "$schema": "https://developer.microsoft.com/json-schemas/office-js/custom-functions.schema.json",
  "functions": [
    {
      "id": "ECHO",
      "name": "ECHO",
      "description": "Returns a test value.",
      "parameters": [{ "name": "value", "type": "string" }],
      "result": { "type": "string", "dimensionality": "scalar" }
    },
    {
      "id": "STREAM",
      "name": "STREAM",
      "description": "Displays Working, then returns the test value.",
      "parameters": [{ "name": "value", "type": "string" }],
      "result": { "type": "string", "dimensionality": "scalar" },
      "options": { "stream": true }
    },
    {
      "id": "SPILL",
      "name": "SPILL",
      "description": "Returns a two-by-two array to test Excel spill behavior.",
      "parameters": [],
      "result": { "type": "string", "dimensionality": "matrix" }
    }
  ]
}
